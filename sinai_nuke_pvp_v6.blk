  mission{
    name:t="sinai_nuke_pvp_v6"
    type:t="teamBattle"
    level:t="levels/avg_egypt_sinai.bin"
    environment:t="Day"
    weather:t="clear"
    restoreType:t="attempts"
    optionalTakeOff:b=no
    campaign:t="UserMissions"
    locName:t="Sinai Nuke: squadre contro (v6)"
    locDesc:t="Battaglia a squadre sulla mappa grande del Sinai: ALLEATI (stella) a nord contro ASSE (croce) a sud. Carri, aerei ed elicotteri: ognuno usa i propri veicoli.<br>NUKE: a 10 uccisioni una piccola da 5 kt, a 25 una da 30 kt. Per sceglierne il punto vola sopra il bersaglio con un aereo o un elicottero sopra 300 m, o spara ai barili del tuo spawn centrale. Dopo 2 minuti parte da sola verso il centro della mappa.<br>Da 20 uccisioni ogni colpo ai barili manda un bombardiere atomico in piu (massimo 3 in volo).<br>A 55 uccisioni arrivano 4 Tu-95M con 2 caccia di scorta: solo uno ha la bomba da 1,6 megatoni. Se la sgancia, la sua squadra vince. Abbattetelo!<br>Vince la prima squadra a 60 uccisioni, o dopo 5 ore chi ne ha di piu. I bombardieri nemici si vedono sulla mappa e si possono abbattere. Le bombe sono vere: distruggono anche i tuoi."
    gt_mp_tickets:b=yes
    deathPenaltyMul:r=0
    ctaCaptureZoneEqualPenaltyMul:r=0
    useAlternativeMapCoord:b=no
    randomSpawnTeams:b=no
    allowEmptyTeams:b=yes
    allowedKillStreaks:b=no
    showTacticalMapCellSize:b=yes
    scoreLimit:i=60000
    timeLimit:i=300
    allowedUnitTypes{
      isAirplanesAllowed:b=yes
      isTanksAllowed:b=yes
      isShipsAllowed:b=no
      isHelicoptersAllowed:b=yes
    }
  }

  spectator_points{}

  cover_points{}
}

