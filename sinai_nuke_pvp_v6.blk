  t1_pronta_1{
    is_enabled:b=yes
    comments:t=""
    props{
      actionsType:t="PERFORM_ONE_BY_ONE"
      conditionsType:t="ALL"
      enableAfterComplete:b=no
    }

    events{
      periodicEvent{
        time:r=1
      }
    }

    conditions{
      varCompareInt{
        var_value:t="t1_kills"
        value:i=10
        comparasion_func:t="notLess"
      }

      varCompareBool{
        var_value:t="partita_finita"
        value:b=no
        comparasion_func:t="equal"
      }
    }

    actions{
      varSetBool{
        value:b=yes
        var:t="t1_in_attesa"
      }

      varSetInt{
        value:i=1
        var:t="t1_tipo"
      }

      varSetInt{
        value:i=0
        var:t="t1_attesa"
      }

      playHint{
        hintType:t="standard"
        name:t="NUKE da 5 kt PRONTA! Vola sopra il punto da colpire sopra 300 m, oppure spara ai barili del tuo spawn centrale. Tra 2 minuti parte da sola verso il centro."
        action:t="show"
        shouldFadeOut:b=no
        isOverFade:b=no
        time:r=10
        priority:i=1
        target_marking:i=0
        object_var_name:t=""
        object_var_comp_op:t="equal"
        object_var_value:i=0
        team:t="A"
      }

      playHint{
        hintType:t="standard"
        name:t="La squadra ALLEATI (stella) ha una nuke da 5 kt pronta: preparatevi ad abbattere il bombardiere!"
        action:t="show"
        shouldFadeOut:b=no
        isOverFade:b=no
        time:r=8
        priority:i=1
        target_marking:i=0
        object_var_name:t=""
        object_var_comp_op:t="equal"
        object_var_value:i=0
        team:t="B"
      }

      playSound{
        name:t="aircraft/ambient/alarm"
        loop:b=no
        start:b=yes
        team:t="A"
      }
    }

    else_actions{}
  }

